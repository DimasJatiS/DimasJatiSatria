# Copy to .env.local and fill in. Every variable is optional: without them the site
# builds and renders from the local seed, and the contact form stays hidden.

# Public site URL without a trailing slash (default: https://dimasjati.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Sanity project id and dataset (dataset default: production).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Shared secret of the Sanity webhook that revalidates content (min. 16 chars). Server only.
SANITY_REVALIDATE_SECRET=

# Contact form: all five are needed, otherwise the form is hidden in production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev only (ignored by production builds): 1 = use the fake fixtures in tests/fixtures/
# (timeline, a case study, contact channels) to preview optional sections.
CONTENT_FIXTURES=
